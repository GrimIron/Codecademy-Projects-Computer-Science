def factorial(n):
  factorial = 1
  if n < 0:
    return ValueError("Inputs 0 or greater only")
  print(f"n = {n}")
  for i in range(1, n+1):
    print(f"i = {i}")
    factorial = factorial*i
    print(f"factorial: {factorial}")
    print()
  return factorial 
  

# test cases
