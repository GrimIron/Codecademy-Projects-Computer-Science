def sum_digits(n):
  if n <= 9:
    return n
  last_num = n % 10  

  # e.x 123 % 10 = 3 
  # retrun sum_digits(12) + 3 

  return sum_digits(n // 10) + last_num 

# test cases
print(sum_digits(123))
print(sum_digits(492))
print(sum_digits(12))
print(sum_digits(12) == 3)
print(sum_digits(552) == 12)
print(sum_digits(123456789) == 45)
