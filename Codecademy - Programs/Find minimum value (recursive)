def find_min(my_list, min = None):
  if not my_list:
    return min
  # eg. [1,3,4]
  if not min or my_list[0] < min:
    # min = 1 
    min = my_list[0]
    # find_min([2,3], 1)
  return find_min(my_list[1:], min)
  
  
# test cases
print(find_min([42, 17, 2, -1, 67]) == -1)
print(find_min([]) == None)
print(find_min([13, 72, 19, 5, 86]) == 5)
