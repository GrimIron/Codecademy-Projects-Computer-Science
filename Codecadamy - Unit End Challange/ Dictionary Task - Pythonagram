score_dictionary = dict(zip(letters, points))

player_to_words = {
  "player1" : ["BLUE", "TENNIS", "EXIT"], 
  "wordNerd" : ["EARTH", "EYES", "MACHINE"], 
  "Lexi Con" : ["ERASER", "BELLY", "HUSKY"],
  "Prof Reader" : ["ZAP", "COMA", "PERIOD"]}
  
points_to_players = {}


# Checks the letters of the word and compares them to the score for letter and added them to the point total
def score_word(word):
  point_total = 0
  for letter in word:
    word_score = score_dictionary.get(letter)
    point_total = point_total + word_score
  return point_total


# Adds a word to a player if the player does not exist added them to the Dict
def play_word(player, word):
  while True:
    try:
      player_to_words[player].append(word)
      break
    except KeyError:
      player_to_words[player] = []
      player_to_words[player].append(word)
      break


# Adds the players name and score to Dict points_to_players{}
def update_point_totals():
  for name in player_to_words:
    player_points = 0 
    for word in player_to_words.get(name):
      player_points = player_points + score_word(word)
    points_to_players[name] = player_points
  for player in points_to_players:
    print(f"{player} score : {points_to_players.get(player)}")

